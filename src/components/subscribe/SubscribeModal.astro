---
import { Image } from 'astro:assets';

import logo from '../../images/logo.png';
import config from '../../website-config';
import SubscribeForm from './SubscribeForm.astro';
---

<dialog class="subscribe-overlay" aria-labelledby="subscribe-overlay-title">
  <button
    class="subscribe-overlay-close"
    type="button"
    aria-label="Close"
    data-close-subscribe
  ></button>
  <div class="subscribe-overlay-content">
    <Image
      class="subscribe-overlay-logo"
      src={logo}
      alt=""
      height={30}
      densities={[1, 2]}
      loading="lazy"
    />
    <h2 class="subscribe-overlay-title" id="subscribe-overlay-title">
      Subscribe to {config.title}
    </h2>
    <p class="subscribe-overlay-description">
      Stay up to date! Get all the latest &amp; greatest posts delivered straight to your inbox
    </p>
    <SubscribeForm id="subscribe-overlay" />
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.subscribe-overlay');
  if (dialog) {
    for (const button of document.querySelectorAll('[data-open-subscribe]')) {
      button.addEventListener('click', () => {
        dialog.showModal();
      });
    }

    dialog.querySelector('[data-close-subscribe]')?.addEventListener('click', () => {
      dialog.close();
    });
  }
</script>

<style>
  .subscribe-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: #fff;
    background: rgba(9, 10, 11, 0.97);
  }

  .subscribe-overlay[open] {
    display: flex;
    justify-content: center;
    align-items: center;
    animation: overlay-in 0.2s ease-in;
  }

  .subscribe-overlay::backdrop {
    background: transparent;
  }

  @keyframes overlay-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  .subscribe-overlay-close {
    position: absolute;
    top: 16px;
    right: 20px;
    z-index: 2000;
    display: block;
    width: 40px;
    height: 40px;
    background: transparent;
  }

  .subscribe-overlay-close::before,
  .subscribe-overlay-close::after {
    content: '';
    position: absolute;
    top: 20px;
    right: 4px;
    display: block;
    width: 32px;
    height: 1px;
    background: #fff;
    opacity: 0.8;
    transform: rotate(45deg);
  }

  .subscribe-overlay-close::after {
    transform: rotate(-45deg);
  }

  .subscribe-overlay-content {
    position: relative;
    margin: 0 0 5vw;
    padding: 4vw;
    text-align: center;
  }

  .subscribe-overlay-logo {
    position: fixed;
    top: 23px;
    left: 30px;
    width: auto;
    height: 30px;
  }

  .subscribe-overlay-title {
    display: inline-block;
    margin: 0 0 10px;
    font-size: 5.2rem;
    line-height: 1.15em;
    font-weight: 600;
  }

  .subscribe-overlay-description {
    margin: 0 auto 50px;
    max-width: 650px;
    color: #fff;
    font-family: var(--font-serif);
    font-size: 2.4rem;
    line-height: 1.3em;
    font-weight: 300;
    opacity: 0.8;
  }

  .subscribe-overlay :global(.subscribe-form) {
    flex-wrap: nowrap;
    max-width: 540px;
  }

  .subscribe-overlay :global(.subscribe-email) {
    padding: 14px 20px;
    border: none;
    font-size: 2rem;
    letter-spacing: 0.5px;
    color: var(--darkgrey);
    background: #fff;
    border-radius: 8px;
  }

  .subscribe-overlay :global(.subscribe-form-button) {
    margin: 0 0 0 15px;
    padding: 0 25px;
    height: 52px;
    font-size: 1.7rem;
    line-height: 38px;
    border-radius: 8px;
  }

  @media (max-width: 500px) {
    .subscribe-overlay :global(.subscribe-form) {
      flex-wrap: wrap;
    }

    .subscribe-overlay :global(.subscribe-form-button) {
      margin: 12px 0 0;
    }

    .subscribe-overlay-title {
      font-size: 3.4rem;
    }
  }
</style>
