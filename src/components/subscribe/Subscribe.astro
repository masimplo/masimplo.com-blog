---
import config from '../../website-config';
import SubscribeForm from './SubscribeForm.astro';
---

<section class="subscribe-form-section">
  <h2 class="subscribe-form-title">Subscribe to {config.title}</h2>
  <p>Get the latest posts delivered right to your inbox</p>
  <SubscribeForm id="subscribe-inline" />
</section>

<style>
  .subscribe-form-section {
    margin: 1.5em 0;
    padding: 6.5vw 7vw 8vw;
    border: #e4eaed 1px solid;
    text-align: center;
    background: linear-gradient(#fbfdfe, #f4f8fb);
    border-radius: 3px;
  }

  .subscribe-form-section p {
    margin: 0 0 1em;
    color: var(--text-muted);
    font-size: 2.1rem;
    line-height: 1.55em;
  }

  @media (max-width: 650px) {
    .subscribe-form-section p {
      font-size: 1.6rem;
    }
  }

  :global(html.dark) .subscribe-form-section {
    border: none;
    background: linear-gradient(#0b0c0e, #121417);
  }

  :global(html.dark) .subscribe-form-section p {
    color: rgba(255, 255, 255, 0.7);
  }

  .subscribe-form-title {
    margin: 0 0 3px;
    padding: 0;
    color: var(--darkgrey);
    font-size: 3.5rem;
    line-height: 1;
    font-weight: 600;
  }

  @media (max-width: 650px) {
    .subscribe-form-title {
      font-size: 2.4rem;
    }
  }

  :global(html.dark) .subscribe-form-title {
    color: rgba(255, 255, 255, 0.9);
  }
</style>
