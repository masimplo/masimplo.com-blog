---
import config from '../website-config';
import SiteNavLogo from './SiteNavLogo.astro';
import SubscribeModal from './subscribe/SubscribeModal.astro';

type Props = {
  isHome?: boolean;
  /** On post pages the nav swaps its links for the post title once the title scrolls away. */
  postTitle?: string;
};

const { isHome = false, postTitle } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
];
---

<nav class="site-nav" aria-label="Main">
  <div class="site-nav-left">
    {!isHome && <SiteNavLogo />}
    <div class="site-nav-content">
      <ul class="nav">
        {links.map(link => (
          <li>
            <a
              href={link.href}
              class:list={{ 'nav-current': path === link.href }}
              aria-current={path === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      {postTitle && (
        <span class="nav-post-title" aria-hidden="true">
          {postTitle}
        </span>
      )}
    </div>
  </div>
  <div class="site-nav-right">
    <div class="social-links">
      {config.facebook && (
        <a
          class="social-link"
          href={config.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M16 0c8.837 0 16 7.163 16 16s-7.163 16-16 16S0 24.837 0 16 7.163 0 16 0zm5.204 4.911h-3.546c-2.103 0-4.443.885-4.443 3.934.01 1.062 0 2.08 0 3.225h-2.433v3.872h2.509v11.147h4.61v-11.22h3.042l.275-3.81h-3.397s.007-1.695 0-2.187c0-1.205 1.253-1.136 1.329-1.136h2.054V4.911z" />
          </svg>
        </a>
      )}
      {config.twitter && (
        <a
          class="social-link"
          href={config.twitter}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M30.063 7.313c-.813 1.125-1.75 2.125-2.875 2.938v.75c0 1.563-.188 3.125-.688 4.625a15.088 15.088 0 0 1-2.063 4.438c-.875 1.438-2 2.688-3.25 3.813a15.015 15.015 0 0 1-4.625 2.563c-1.813.688-3.75 1-5.75 1-3.25 0-6.188-.875-8.875-2.625.438.063.875.125 1.375.125 2.688 0 5.063-.875 7.188-2.5-1.25 0-2.375-.375-3.375-1.125s-1.688-1.688-2.063-2.875c.438.063.813.125 1.125.125.5 0 1-.063 1.5-.25-1.313-.25-2.438-.938-3.313-1.938a5.673 5.673 0 0 1-1.313-3.688v-.063c.813.438 1.688.688 2.625.688a5.228 5.228 0 0 1-1.875-2c-.5-.875-.688-1.813-.688-2.75 0-1.063.25-2.063.75-2.938 1.438 1.75 3.188 3.188 5.25 4.25s4.313 1.688 6.688 1.813a5.579 5.579 0 0 1 1.5-5.438c1.125-1.125 2.5-1.688 4.125-1.688s3.063.625 4.188 1.813a11.48 11.48 0 0 0 3.688-1.375c-.438 1.375-1.313 2.438-2.563 3.188 1.125-.125 2.188-.438 3.313-.875z" />
          </svg>
        </a>
      )}
    </div>
    <button
      class="dark-mode-toggle"
      type="button"
      aria-label="Switch to dark mode"
      aria-pressed="false"
    >
      <svg
        class="icon-moon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.7-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z"
          clip-rule="evenodd"
        />
      </svg>
      <svg
        class="icon-sun"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 2.25a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75ZM7.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM18.894 6.166a.75.75 0 0 0-1.06-1.06l-1.591 1.59a.75.75 0 1 0 1.06 1.061l1.591-1.59ZM21.75 12a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1 0-1.5H21a.75.75 0 0 1 .75.75ZM17.834 18.894a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 1 0-1.061 1.06l1.59 1.591ZM12 18a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-2.25A.75.75 0 0 1 12 18ZM7.758 17.303a.75.75 0 0 0-1.061-1.06l-1.591 1.59a.75.75 0 0 0 1.06 1.061l1.591-1.59ZM6 12a.75.75 0 0 1-.75.75H3a.75.75 0 0 1 0-1.5h2.25A.75.75 0 0 1 6 12ZM6.697 7.757a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 0 0-1.061 1.06l1.59 1.591Z" />
      </svg>
    </button>
    {config.showSubscribe && (
      <button class="subscribe-button" type="button" data-open-subscribe>
        Subscribe
      </button>
    )}
  </div>
</nav>
{config.showSubscribe && <SubscribeModal />}

<script>
  const root = document.documentElement;

  for (const toggle of document.querySelectorAll<HTMLButtonElement>('.dark-mode-toggle')) {
    const sync = () => {
      const isDark = root.classList.contains('dark');
      toggle.setAttribute('aria-pressed', String(isDark));
      toggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
      toggle.title = toggle.getAttribute('aria-label')!;
    };

    sync();
    toggle.addEventListener('click', () => {
      const isDark = root.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {
        // Storage can be unavailable (private mode); the toggle still works for this page.
      }

      sync();
    });
  }

  // Swap the nav links for the post title once the article's title has scrolled out of view.
  const navContent = document.querySelector('.site-nav-content');
  const postTitle = document.querySelector('.post-full-title');
  if (navContent && postTitle && document.querySelector('.nav-post-title')) {
    new IntersectionObserver(([entry]) => {
      navContent.classList.toggle(
        'show-title',
        !entry.isIntersecting && entry.boundingClientRect.top < 0,
      );
    }).observe(postTitle);
  }
</script>

<style>
  .site-nav {
    position: relative;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    overflow-y: hidden;
    height: 64px;
    font-size: 1.3rem;
  }

  .site-nav-left {
    flex: 1 0 auto;
    display: flex;
    align-items: center;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    margin-right: 10px;
    padding: 10px 0 80px;
    font-weight: 500;
    letter-spacing: 0.2px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .site-nav-left {
      margin-right: 0;
      padding-left: 5vw;
    }
  }

  .site-nav-content {
    position: relative;
    align-self: flex-start;
  }

  .nav {
    position: absolute;
    z-index: 1000;
    display: flex;
    margin: 0 0 0 -12px;
    padding: 0;
    list-style: none;
    transition: all 1s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .nav li {
    display: block;
    margin: 0;
    padding: 0;
  }

  .nav li::marker {
    content: none;
  }

  .nav li a {
    position: relative;
    display: block;
    padding: 12px;
    color: #fff;
    opacity: 0.85;
    transition: opacity 0.35s ease-in-out;
  }

  .nav li a:hover {
    text-decoration: none;
    opacity: 1;
  }

  .nav li a::before {
    content: '';
    position: absolute;
    right: 100%;
    bottom: 8px;
    left: 12px;
    height: 1px;
    background: #fff;
    opacity: 0.25;
    transition: all 0.35s ease-in-out;
  }

  .nav li a:hover::before {
    right: 12px;
    opacity: 0.5;
  }

  .nav li a.nav-current {
    opacity: 1;
  }

  .nav-post-title {
    visibility: hidden;
    position: absolute;
    top: 9px;
    color: #fff;
    font-size: 1.7rem;
    font-weight: 400;
    text-transform: none;
    opacity: 0;
    transition: all 1s cubic-bezier(0.19, 1, 0.22, 1);
    transform: translateY(175%);
  }

  .site-nav-content.show-title .nav {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-175%);
  }

  .site-nav-content.show-title .nav-post-title {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  .site-nav-right {
    flex: 0 1 auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 10px 0;
    height: 64px;
  }

  @media (max-width: 700px) {
    .site-nav-right {
      padding-right: 5vw;
    }

    .site-nav-right .social-links,
    .site-nav-right .subscribe-button {
      display: none;
    }
  }

  .social-links {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .social-link {
    display: inline-block;
    margin: 0;
    padding: 10px;
    opacity: 0.85;
  }

  .social-link:hover {
    opacity: 1;
  }

  .social-link svg {
    height: 1.8rem;
    fill: #fff;
  }

  .dark-mode-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 0 6px;
    padding: 10px;
    color: #fff;
    background: transparent;
    opacity: 0.85;
  }

  .dark-mode-toggle:hover {
    opacity: 1;
  }

  .dark-mode-toggle svg {
    display: block;
  }

  .dark-mode-toggle .icon-sun,
  :global(html.dark) .dark-mode-toggle .icon-moon {
    display: none;
  }

  :global(html.dark) .dark-mode-toggle .icon-sun {
    display: block;
  }

  .subscribe-button {
    display: block;
    margin: 0 0 0 10px;
    padding: 4px 10px;
    border: #fff 1px solid;
    color: #fff;
    font-size: 1.3rem;
    line-height: 1em;
    background: transparent;
    border-radius: 10px;
    opacity: 0.85;
  }

  .subscribe-button:hover {
    opacity: 1;
  }
</style>
