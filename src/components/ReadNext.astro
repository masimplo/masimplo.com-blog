---
import { displayDate, isoDate, type PostSummary, tagUrl } from '../lib/posts';
import PostCard from './PostCard.astro';

type Props = {
  primaryTag?: string;
  /** Up to 3 other posts in the primary tag, oldest first. */
  related: PostSummary[];
  /** Total published posts in the primary tag, including the current one. */
  tagCount: number;
  prev?: PostSummary;
  next?: PostSummary;
};

const { primaryTag, related, tagCount, prev, next } = Astro.props;
---

<aside class="read-next outer" aria-label="Read next">
  <div class="inner">
    <div class="read-next-feed">
      {primaryTag && tagCount > 1 && (
        <article class="read-next-card">
          <header class="read-next-card-header">
            <h2 class="read-next-card-header-title">
              <span>More in</span> <a href={tagUrl(primaryTag)}>{primaryTag}</a>
            </h2>
          </header>
          <div class="read-next-card-content">
            <ul>
              {related.map(post => (
                <li>
                  <h3 class="read-next-card-post-title">
                    <a href={post.slug}>{post.title}</a>
                  </h3>
                  <div class="read-next-card-meta">
                    <p>
                      <time datetime={isoDate(post.date)}>{displayDate(post.date)}</time> –{' '}
                      {post.readingTime}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
          <footer class="read-next-card-footer">
            <a href={tagUrl(primaryTag)}>See all {tagCount} posts →</a>
          </footer>
        </article>
      )}
      {prev && <PostCard post={prev} />}
      {next && <PostCard post={next} />}
    </div>
  </div>
</aside>

<style>
  .read-next {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: var(--nav-bg);
  }

  .read-next-feed {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -25px;
    padding: 60px 0 0;
  }

  .read-next :global(.post-card) {
    padding-bottom: 0;
    border-bottom: none;
  }

  .read-next :global(.post-card-primary-tag) {
    color: rgba(255, 255, 255, 0.7);
  }

  .read-next :global(.post-card-content-link),
  :global(html.dark) .read-next a.post-card-content-link {
    color: #fff;
  }

  .read-next :global(.post-card-title) {
    color: #fff;
    opacity: 0.85;
    transition: all 0.2s ease-in-out;
  }

  .read-next :global(.post-card-excerpt),
  :global(html.dark) .read-next :global(.post-card-excerpt) {
    color: rgba(255, 255, 255, 0.65);
  }

  .read-next :global(.post-card-byline-content) {
    color: rgba(255, 255, 255, 0.65);
  }

  .read-next :global(.post-card .post-card-byline-content a) {
    color: rgba(255, 255, 255, 0.85);
  }

  .read-next :global(.author-avatar) {
    border-color: var(--nav-bg);
  }

  .read-next :global(.author-profile-image) {
    background: var(--nav-bg);
  }

  @media (max-width: 650px) {
    .read-next :global(.post-card) {
      flex: 1 1 auto;
      margin: 25px;
      padding: 25px 0 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
  }

  .read-next-card {
    position: relative;
    flex: 0 1 326px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    margin: 0 25px 50px;
    padding: 25px;
    background: linear-gradient(#1a1c20, #0a0b0c);
    border-radius: 3px;
  }

  .read-next-card a {
    transition: all 0.2s ease-in-out;
  }

  .read-next-card a:hover {
    text-decoration: none;
  }

  @media (max-width: 1170px) {
    .read-next-card {
      flex: 1 1 261px;
      margin-bottom: 5vw;
    }
  }

  @media (max-width: 650px) {
    .read-next-card {
      flex: 1 1 auto;
      margin: 0 25px;
      padding: 0;
      background: none;
    }
  }

  .read-next-card-header-title {
    margin: 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 1.2rem;
    line-height: 1em;
    font-weight: 300;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  .read-next-card-header-title a {
    color: #fff;
    font-weight: 500;
    opacity: 0.85;
  }

  .read-next-card-header-title a:hover {
    opacity: 1;
  }

  .read-next-card-content {
    font-size: 1.7rem;
  }

  .read-next-card-content ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .read-next-card-content li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin: 0;
    padding: 20px 0;
  }

  .read-next-card-content li::marker {
    content: none;
  }

  .read-next-card-content li:last-of-type {
    padding-bottom: 5px;
  }

  .read-next-card-content .read-next-card-post-title {
    margin: 0;
    font-size: 1.6rem;
    line-height: 1.35em;
    font-weight: 600;
  }

  .read-next-card-content li a {
    display: block;
    color: #fff;
    opacity: 0.85;
  }

  .read-next-card-content li a:hover {
    opacity: 1;
  }

  .read-next-card-meta {
    margin-top: 2px;
    font-size: 1.2rem;
    line-height: 1.4em;
    font-weight: 400;
  }

  .read-next-card-meta p {
    margin: 0;
    color: rgba(255, 255, 255, 0.65);
  }

  .read-next-card-footer {
    position: relative;
    margin: 40px 0 5px;
  }

  .read-next-card-footer a {
    padding: 7px 12px 8px 14px;
    border: 1px solid rgba(255, 255, 255, 0.65);
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.3rem;
    border-radius: 999px;
    transition: all 0.35s ease-in-out;
  }

  .read-next-card-footer a:hover {
    border-color: var(--yellow);
    color: var(--yellow);
  }
</style>
