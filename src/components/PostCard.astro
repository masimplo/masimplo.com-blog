---
import { Picture } from 'astro:assets';

import { authorUrl, displayDate, isoDate, type PostSummary, tagUrl } from '../lib/posts';
import config from '../website-config';
import AuthorList from './AuthorList.astro';

type Props = {
  post: PostSummary;
  /** Full-width hero card: first post on the home page. */
  isLarge?: boolean;
  /** Load the image eagerly; only for cards visible on first paint. */
  eager?: boolean;
};

const { post, isLarge = false, eager = isLarge } = Astro.props;
const tags = config.showAllTags ? post.tags : post.tags.slice(0, 1);
---

<article class:list={['post-card', { 'no-image': !post.image, 'post-card-large': isLarge }]}>
  {post.image && (
    <a class="post-card-image-link" href={post.slug} tabindex="-1" aria-hidden="true">
      <Picture
        class="post-card-image"
        src={post.image}
        alt=""
        formats={['avif']}
        fallbackFormat="webp"
        widths={isLarge ? [480, 720, 960, 1280] : [360, 540, 720, 1000]}
        sizes={
          isLarge
            ? '(max-width: 794px) calc(90vw - 40px), (max-width: 1150px) calc(90vw - 400px), 640px'
            : '(max-width: 794px) calc(90vw - 40px), 340px'
        }
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={isLarge && eager ? 'high' : undefined}
      />
    </a>
  )}
  <div class="post-card-content">
    <header class="post-card-header">
      {tags.length > 0 && (
        <div class="post-card-primary-tag">
          {tags.map((tag, idx) => (
            <>
              {idx > 0 && ', \u00a0'}
              <a href={tagUrl(tag)}>{tag}</a>
            </>
          ))}
        </div>
      )}
      <a class="post-card-content-link" href={post.slug}>
        <h2 class="post-card-title">{post.title}</h2>
        <section class="post-card-excerpt">
          <p>{post.excerpt}</p>
        </section>
      </a>
    </header>
    <footer class="post-card-meta">
      <AuthorList authors={post.authors} tooltip="small" />
      <div class="post-card-byline-content">
        <span>
          {post.authors.map(({ data: author }, index) => (
            <>
              <a href={authorUrl(author.name)}>{author.name}</a>
              {index < post.authors.length - 1 && ', '}
            </>
          ))}
        </span>
        <span class="post-card-byline-date">
          <time datetime={isoDate(post.date)}>{displayDate(post.date)}</time>{' '}
          <span class="bull">&bull;</span> {post.readingTime}
        </span>
      </div>
    </footer>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    flex: 1 1 301px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    margin: 0 0 40px;
    padding: 0 20px 40px;
    min-height: 220px;
  }

  .post-card-image-link {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 5px 5px 0 0;
  }

  .post-card-image {
    display: block;
    width: 100%;
    height: 200px;
    object-fit: cover;
    background: var(--lightgrey);
  }

  :global(html.dark) .post-card-image {
    background: var(--darkmode);
  }

  .post-card-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .post-card-header {
    margin: 15px 0 0;
  }

  .post-card-primary-tag {
    margin: 0 0 0.2em;
    color: var(--text-accent);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.2px;
    text-transform: uppercase;
  }

  .post-card-primary-tag a {
    color: inherit;
  }

  .post-card-content-link {
    position: relative;
    display: block;
    color: var(--darkgrey);
  }

  .post-card-content-link:hover {
    text-decoration: none;
  }

  :global(html.dark) a.post-card-content-link {
    color: rgba(255, 255, 255, 0.85);
  }

  .post-card-title {
    margin: 0 0 0.4em;
    line-height: 1.15em;
    transition: color 0.2s ease-in-out;
  }

  .post-card-excerpt {
    font-family: var(--font-serif);
  }

  .post-card-excerpt p {
    margin: 0 0 1.5em;
  }

  :global(html.dark) .post-card-excerpt {
    color: #90a2aa;
  }

  .post-card-meta {
    display: flex;
    align-items: flex-start;
    padding: 0;
  }

  .post-card-byline-content {
    flex: 1 1 50%;
    display: flex;
    flex-direction: column;
    margin: 4px 0 0 10px;
    color: var(--text-muted);
    font-size: 1.2rem;
    line-height: 1.4em;
    font-weight: 400;
    letter-spacing: 0.2px;
    text-transform: uppercase;
  }

  .post-card-byline-content span {
    margin: 0;
  }

  .post-card-byline-content a {
    color: #434952;
    font-weight: 600;
  }

  :global(html.dark) .post-card-byline-content a {
    color: rgba(255, 255, 255, 0.75);
  }

  .bull {
    display: inline-block;
    margin: 0 4px;
    opacity: 0.6;
  }

  @media (min-width: 795px) {
    .post-card-large {
      flex: 1 1 100%;
      flex-direction: row;
      padding-bottom: 40px;
      min-height: 280px;
      border-top: 0;
    }

    .post-card-large:not(.no-image) .post-card-header {
      margin-top: 0;
    }

    .post-card-large .post-card-image-link {
      position: relative;
      flex: 1 1 auto;
      margin-bottom: 0;
      min-height: 380px;
    }

    .post-card-large .post-card-image {
      position: absolute;
      width: 100%;
      height: 100%;
    }

    .post-card-large .post-card-content {
      flex: 0 1 361px;
      justify-content: center;
    }

    .post-card-large .post-card-title {
      margin-top: 0;
      font-size: 3.2rem;
    }

    .post-card-large .post-card-header,
    .post-card-large .post-card-meta {
      padding: 0 0 0 40px;
    }

    .post-card-large .post-card-excerpt p {
      margin-bottom: 1.5em;
      font-size: 1.8rem;
      line-height: 1.5em;
    }
  }
</style>
