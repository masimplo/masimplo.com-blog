---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

type Props = {
  image: ImageMetadata;
  alt: string;
  /** `page`: the shorter, top-anchored banner of standalone pages like About. */
  variant?: 'post' | 'page';
};

const { image, alt, variant = 'post' } = Astro.props;
// Never upscale: cap the srcset at the source width (and 2000px).
const widths = [
  ...[480, 800, 1200, 1600, 2000].filter(w => w < image.width),
  Math.min(image.width, 2000),
];
---

<figure class:list={['post-full-image', { 'page-hero': variant === 'page' }]}>
  <Picture
    src={image}
    alt={alt}
    formats={['avif']}
    fallbackFormat="webp"
    widths={widths}
    sizes="(max-width: 1170px) 100vw, 1040px"
    loading="eager"
    fetchpriority="high"
  />
</figure>

<style>
  .post-full-image {
    margin: 25px 0 50px;
    height: 800px;
    overflow: hidden;
    background: var(--lightgrey);
    border-radius: 5px;
  }

  :global(html.dark) .post-full-image {
    background: var(--darkmode);
  }

  .post-full-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 1170px) {
    .post-full-image {
      margin: 25px -6vw 50px;
      border-radius: 0;
    }
  }

  @media (max-width: 800px) {
    .post-full-image {
      height: 400px;
    }
  }

  @media (max-width: 500px) {
    .post-full-image {
      margin-bottom: 4vw;
      height: 350px;
    }
  }

  .post-full-image.page-hero {
    height: 500px;
  }

  .post-full-image.page-hero img {
    object-position: center top;
  }

  @media (max-width: 800px) {
    .post-full-image.page-hero {
      height: 200px;
    }
  }

  @media (max-width: 500px) {
    .post-full-image.page-hero {
      height: 150px;
    }
  }
</style>
