---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

import SiteNav from './SiteNav.astro';

type Props = {
  /** Background photo; without one the header renders on a plain page background. */
  image?: ImageMetadata;
};

const { image } = Astro.props;
---

<header class="site-archive-header">
  <div class="site-nav-main outer">
    <div class="inner">
      <SiteNav />
    </div>
  </div>
  <div class:list={['site-header-background outer', image ? 'has-image' : 'no-image']}>
    {image && (
      <Picture
        class="header-bg-image"
        src={image}
        alt=""
        formats={['avif']}
        fallbackFormat="webp"
        widths={[640, 1000, 1500, 2000].filter(w => w <= image.width)}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="inner">
      <slot />
    </div>
  </div>
</header>
