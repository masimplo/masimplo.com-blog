---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

import FixedSiteNav from './FixedSiteNav.astro';

type Props = {
  /** Background photo; without one the header renders on a plain page background. */
  image?: ImageMetadata;
};

const { image } = Astro.props;
---

<header class="site-archive-header">
  <FixedSiteNav />
  <div class:list={['site-header-background outer', image ? 'has-image' : 'no-image']}>
    {image && (
      <Picture
        class="header-bg-image"
        src={image}
        alt=""
        formats={['avif']}
        fallbackFormat="webp"
        widths={[640, 1000, 1500, 2000].filter(w => w <= image.width)}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="inner">
      <slot />
    </div>
  </div>
</header>

<style>
  .site-header-background.has-image::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 10;
    display: block;
    background: rgba(0, 0, 0, 0.18);
  }

  .site-header-background.has-image::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 10;
    display: block;
    height: 140px;
    background: linear-gradient(rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0));
  }

  :global(html.dark) .site-header-background.has-image::before {
    background: rgba(0, 0, 0, 0.6);
  }

  .site-header-background :global(.inner) {
    position: relative;
    z-index: 100;
  }

  /* Tag and author archive headers */
  .site-header-background {
    margin-top: 64px;
  }

  .site-header-background.has-image {
    position: relative;
    color: #fff;
    background: #090a0b no-repeat 50%;
    background-size: cover;
  }

  .site-header-background > picture,
  .site-header-background > .header-bg-image {
    position: absolute;
    inset: 0;
  }

  .site-header-background .header-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
  }

  .site-archive-header :global(.site-header-content) {
    position: relative;
    align-items: stretch;
    padding: 12vw 0 20px;
    min-height: 200px;
    max-height: 600px;
  }

  .site-header-background.no-image {
    padding-top: 0;
    padding-bottom: 0;
    color: var(--darkgrey);
    background: #fff;
  }

  .site-header-background.no-image :global(.site-description) {
    color: var(--text-muted);
    opacity: 1;
  }

  .site-header-background.no-image :global(.site-header-content) {
    padding: 5vw 0 10px;
    border-bottom: 1px solid #eaeff1;
  }

  :global(html.dark) .site-header-background.no-image {
    color: rgba(255, 255, 255, 0.9);
    background: var(--darkmode);
  }

  :global(html.dark) .site-header-background.no-image :global(.site-header-content) {
    border-bottom-color: #272a30;
  }

  @media (max-width: 500px) {
    .site-archive-header :global(.site-header-content) {
      flex-direction: column;
      align-items: center;
      min-height: unset;
      padding: 12vw 0 20px;
    }

    .site-archive-header :global(.site-title) {
      font-size: 4.2rem;
      text-align: center;
    }
  }
</style>
