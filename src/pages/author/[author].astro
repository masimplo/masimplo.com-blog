---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { kebabCase } from 'lodash-es';

import ArchiveHeader from '../../components/ArchiveHeader.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Author, countLabel, getPostSummaries, type PostSummary } from '../../lib/posts';

export async function getStaticPaths() {
  // Author archives list posts oldest first.
  const posts = (await getPostSummaries()).reverse();
  const authors = await getCollection('authors');

  return authors.map(author => ({
    params: { author: kebabCase(author.data.name) },
    props: {
      author,
      posts: posts.filter(post => post.authors.some(a => a.id === author.id)),
    },
  }));
}

type Props = { author: Author; posts: PostSummary[] };

const { author: entry, posts } = Astro.props;
const author = entry.data;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const twitterHandle = author.twitter ? `@${author.twitter}` : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  url: author.website ?? pageUrl,
  ...(author.twitter && { sameAs: [`https://twitter.com/${author.twitter}`] }),
  ...(author.bio && { description: author.bio }),
};
---

<BaseLayout
  title={`${author.name} - masimplo.com`}
  description={author.bio}
  type="profile"
  twitterCard="summary"
  jsonLd={[jsonLd]}
>
  <Fragment slot="head">
    {author.twitter && (
      <meta property="article:author" content={`https://twitter.com/${author.twitter}`} />
    )}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
  </Fragment>

  <ArchiveHeader image={author.profile_image}>
    <div class="site-header-content author-header">
      <Image
        class="author-profile-image"
        src={author.avatar}
        alt={author.name}
        width={110}
        height={110}
        densities={[1, 2]}
        loading="eager"
      />
      <div class="author-header-content">
        <h1 class="site-title">{author.name}</h1>
        {author.bio && <p class="author-bio">{author.bio}</p>}
        <div class="author-meta">
          {author.location && <div class="author-location">{author.location}</div>}
          <div class="author-stats">{countLabel(posts.length)}</div>
          {author.website && (
            <span class="author-social-link">
              <a href={author.website} target="_blank" rel="noopener noreferrer">
                Website
              </a>
            </span>
          )}
          {author.twitter && (
            <span class="author-social-link">
              <a
                href={`https://twitter.com/${author.twitter}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Twitter
              </a>
            </span>
          )}
          {author.facebook && (
            <span class="author-social-link">
              <a
                href={`https://www.facebook.com/${author.facebook}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Facebook
              </a>
            </span>
          )}
        </div>
      </div>
    </div>
  </ArchiveHeader>
  <main id="site-main" class="site-main outer">
    <div class="inner">
      <div class="post-feed">
        {posts.map((post, index) => (
          <PostCard post={post} eager={index < 3} />
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .author-profile-image {
    display: block;
    background: #e4eaed;
    border-radius: 100%;
    object-fit: cover;
  }

  :global(html.dark) .author-profile-image {
    background: var(--darkmode);
  }

  :global(.site-header-background):global(.no-image) .author-bio,
  :global(.site-header-background):global(.no-image) .author-meta {
    color: var(--text-muted);
    opacity: 1;
  }

  :global(.site-header-background):global(.no-image) .author-social-link a {
    color: var(--darkgrey);
  }

  :global(.site-header-background):global(.no-image) .author-meta > * + *::before {
    color: var(--text-muted);
  }

  :global(html.dark) :global(.site-header-background):global(.no-image) .author-social-link a {
    color: rgba(255, 255, 255, 0.75);
  }

  .author-header {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    padding: 10vw 0 10px;
  }

  :global(.site-archive-header) :global(.site-header-content).author-header {
    flex-direction: row;
    align-items: center;
  }

  @media (max-width: 500px) {
    :global(.site-archive-header) :global(.site-header-content).author-header {
      flex-direction: column;
      padding: 10px 0;
    }
  }

  .author-header .author-profile-image {
    z-index: 10;
    flex-shrink: 0;
    margin: 4px 0 0;
    width: 110px;
    height: 110px;
    box-shadow: rgba(255, 255, 255, 0.1) 0 0 0 6px;
  }

  .author-header-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 5px 0 0 30px;
  }

  @media (max-width: 500px) {
    .author-header-content {
      align-items: center;
      margin: 16px 0 0;
    }
  }

  .author-bio {
    z-index: 10;
    flex-shrink: 0;
    margin: 6px 0 0;
    max-width: 46em;
    font-size: 2rem;
    line-height: 1.3em;
    font-weight: 400;
    opacity: 0.8;
  }

  .author-meta {
    z-index: 10;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    margin: 0 0 0 1px;
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: 0.2px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .author-meta > * + *::before {
    content: '•';
    display: inline-block;
    margin: 0 12px;
    opacity: 0.6;
  }

  .author-social-link {
    display: inline-block;
    margin: 0;
    padding: 6px 0;
  }

  .author-social-link a,
  :global(html.dark) :global(.has-image) .author-social-link a {
    color: #fff;
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .author-meta .author-location,
    .author-meta .author-stats,
    .author-meta .author-stats + .author-social-link::before {
      display: none;
    }
  }

  @media (max-width: 500px) {
    .author-meta {
      margin-top: 8px;
    }
  }
</style>
