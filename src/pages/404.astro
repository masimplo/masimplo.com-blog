---
import PostCard from '../components/PostCard.astro';
import FixedSiteNav from '../components/FixedSiteNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostSummaries } from '../lib/posts';

const latest = (await getPostSummaries()).slice(0, 3);
---

<BaseLayout title="Page not found — masimplo.com" description="This page does not exist.">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <header class="site-archive-header">
    <FixedSiteNav />
  </header>
  <main id="site-main" class="error-content outer">
    <div class="inner">
      <section style="text-align: center">
        <h1 class="error-code">404</h1>
        <p class="error-description">Page not found</p>
        <a class="error-link" href="/">
          Go to the front page →
        </a>
      </section>

      <div class="post-feed">
        {latest.map(post => (
          <PostCard post={post} />
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .error-content {
    padding: 14vw 4vw 6vw;
  }

  @media (max-width: 800px) {
    .error-content {
      padding-top: 24vw;
    }
  }

  @media (max-width: 500px) {
    .error-content {
      padding-top: 28vw;
    }
  }

  @media (min-width: 940px) {
    .error-content :global(.post-card) {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }
  }

  .error-code {
    margin: 0;
    color: var(--midgrey);
    font-size: 12vw;
    line-height: 1em;
    letter-spacing: -5px;
  }

  @media (max-width: 800px) {
    .error-code {
      font-size: 11.2rem;
    }
  }

  .error-description {
    margin: 0;
    color: var(--text-muted);
    font-size: 3rem;
    line-height: 1.3em;
    font-weight: 400;
  }

  @media (max-width: 800px) {
    .error-description {
      margin: 5px 0 0;
      font-size: 1.8rem;
    }
  }

  .error-link {
    display: inline-block;
    margin-top: 5px;
  }
</style>
