---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';

import ArticleHeader from '../components/ArticleHeader.astro';
import AuthorList from '../components/AuthorList.astro';
import Footer from '../components/Footer.astro';
import FixedSiteNav from '../components/FixedSiteNav.astro';
import PostHero from '../components/PostHero.astro';
import Prose from '../components/Prose.astro';
import ReadNext from '../components/ReadNext.astro';
import Subscribe from '../components/subscribe/Subscribe.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  authorUrl,
  displayDate,
  getPublishedPosts,
  isoDate,
  type Post,
  postUrl,
  summarize,
  tagUrl,
} from '../lib/posts';
import config from '../website-config';

export async function getStaticPaths() {
  // Oldest first, so "prev" is the previous (older) post and "next" the newer one.
  const posts = (await getPublishedPosts()).reverse();
  return posts.map((post, index) => ({
    params: { slug: postUrl(post).replace(/^\/|\/$/g, '') },
    props: { post, posts, index },
  }));
}

type Props = { post: Post; posts: Post[]; index: number };

const { post, posts, index } = Astro.props;
const { Content } = await render(post);
const summary = await summarize(post);
const { title, tags, image } = post.data;
const author = summary.authors[0]?.data;
const primaryTag = tags[0];
const url = new URL(summary.slug, Astro.site).href;

// "More in <tag>": the oldest five posts in the primary tag, minus this one, capped at three.
const tagPosts = primaryTag ? posts.filter(p => p.data.tags.includes(primaryTag)) : [];
const related = await Promise.all(
  tagPosts
    .slice(0, 5)
    .filter(p => p.id !== post.id)
    .slice(0, 3)
    .map(async p => summarize(p)),
);
const prev = index > 0 ? await summarize(posts[index - 1]) : undefined;
const next = index < posts.length - 1 ? await summarize(posts[index + 1]) : undefined;

const social = image
  ? await getImage({
      src: image,
      width: Math.min(1200, image.width),
      format: image.format === 'png' ? 'png' : 'jpg',
    })
  : undefined;
const socialImage = social && {
  src: social.src,
  width: Number(social.attributes.width),
  height: Number(social.attributes.height),
};
const twitterHandle = config.twitter
  ? `@${config.twitter.split('https://twitter.com/')[1]}`
  : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: summary.excerpt,
  datePublished: post.data.date.toISOString(),
  url,
  mainEntityOfPage: url,
  ...(socialImage && { image: new URL(socialImage.src, Astro.site).href }),
  ...(primaryTag && { keywords: tags.join(', ') }),
  author: author && {
    '@type': 'Person',
    name: author.name,
    url: new URL(authorUrl(author.name), Astro.site).href,
  },
  publisher: {
    '@type': 'Organization',
    name: config.title,
    url: config.siteUrl,
  },
};
---

<BaseLayout
  title={title}
  description={summary.excerpt}
  type="article"
  image={socialImage}
  jsonLd={[jsonLd]}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    {primaryTag && <meta property="article:tag" content={primaryTag} />}
    {config.facebook && <meta property="article:author" content={config.facebook} />}
    {author && <meta name="twitter:label1" content="Written by" />}
    {author && <meta name="twitter:data1" content={author.name} />}
    {primaryTag && <meta name="twitter:label2" content="Filed under" />}
    {primaryTag && <meta name="twitter:data2" content={primaryTag} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
  </Fragment>

  <header class="site-header">
    <FixedSiteNav postTitle={title} />
  </header>
  <main id="site-main" class="site-main under-nav outer">
    <div class="inner">
      <article class:list={['post-full', { 'no-image': !image }]}>
        <ArticleHeader title={title}>
          <section class="post-full-tags" aria-label="Tags" slot="before">
            {(config.showAllTags ? tags : tags.slice(0, 1)).map((tag, idx) => (
              <>
                {idx > 0 && ', \u00a0'}
                <a href={tagUrl(tag)}>{tag}</a>
              </>
            ))}
          </section>
          {post.data.excerpt && <p class="post-full-custom-excerpt">{post.data.excerpt}</p>}
          <div class="post-full-byline">
            <section class="post-full-byline-content">
              <AuthorList authors={summary.authors} tooltip="large" />
              <section class="post-full-byline-meta">
                <p class="author-name">
                  {summary.authors.map(a => (
                    <a href={authorUrl(a.data.name)}>{a.data.name}</a>
                  ))}
                </p>
                <div class="byline-meta-content">
                  <time class="byline-meta-date" datetime={isoDate(post.data.date)}>
                    {displayDate(post.data.date)}
                  </time>
                  <span class="byline-reading-time">
                    <span class="bull">&bull;</span>
                    {summary.readingTime}
                  </span>
                </div>
              </section>
            </section>
          </div>
        </ArticleHeader>

        {image && <PostHero image={image} alt={title} />}

        <Prose>
          <Content />
        </Prose>

        <div class="post-footer-note">
          <p>
            Thanks for reading! To stay updated on my latest posts and thoughts, follow me on
            Twitter <a href="https://twitter.com/masimplo">@masimplo</a>
          </p>
        </div>
        {config.showSubscribe && <Subscribe />}
      </article>
    </div>
  </main>

  <ReadNext
    primaryTag={primaryTag}
    related={related}
    tagCount={tagPosts.length}
    prev={prev}
    next={next}
  />
  <Footer />
</BaseLayout>

<style>
  .post-full {
    position: relative;
    z-index: 50;
  }

  .post-full-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    color: var(--text-muted);
    font-size: 1.3rem;
    line-height: 1.4em;
    font-weight: 600;
    text-transform: uppercase;
  }

  .post-full-tags a {
    color: var(--text-accent);
  }

  :global(html.dark) .post-full-custom-excerpt {
    color: #90a2aa;
  }

  :global(html.dark) .post-full-tags {
    color: rgba(255, 255, 255, 0.5);
  }

  :global(html.dark) .post-full-tags a {
    color: rgba(255, 255, 255, 0.6);
  }

  :global(html.dark) .post-full-tags a:hover {
    color: rgba(255, 255, 255, 0.85);
  }

  .post-full-custom-excerpt {
    margin: 20px 0 0;
    font-family: var(--font-serif);
    font-size: 2.3rem;
    line-height: 1.4em;
    font-weight: 300;
  }

  @media (max-width: 500px) {
    .post-full-custom-excerpt {
      font-size: 1.9rem;
      line-height: 1.5em;
    }
  }

  .post-full-byline {
    display: flex;
    justify-content: space-between;
    margin: 35px 0 0;
    padding-top: 15px;
    border-top: 1px solid #e4eaed;
  }

  :global(html.dark) .post-full-byline {
    border-top-color: #3b4049;
  }

  .post-full-byline-content {
    flex-grow: 1;
    display: flex;
    align-items: flex-start;
  }

  .post-full-byline-content :global(.author-list) {
    justify-content: flex-start;
    padding: 0 12px 0 0;
  }

  .post-full-byline-meta {
    margin: 2px 0 0;
    color: var(--text-muted);
    font-size: 1.2rem;
    line-height: 1.2em;
    letter-spacing: 0.2px;
    text-transform: uppercase;
  }

  .post-full-byline-meta .author-name {
    margin: 0 0 3px;
    font-size: 1.3rem;
    line-height: 1.4em;
    font-weight: 500;
  }

  .post-full-byline-meta .author-name a {
    color: #2c3036;
  }

  .post-full-byline-meta .author-name a:hover {
    color: var(--darkgrey);
  }

  :global(html.dark) .post-full-byline-meta .author-name a {
    color: rgba(255, 255, 255, 0.75);
  }

  :global(html.dark) .post-full-byline-meta .author-name a:hover {
    color: #fff;
  }

  .post-footer-note {
    margin-bottom: 4vh;
    padding: 0 8vw;
    text-align: center;
  }

  .post-footer-note a {
    text-decoration: underline;
  }

  .bull {
    display: inline-block;
    margin: 0 4px;
    opacity: 0.6;
  }
</style>
